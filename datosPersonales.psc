Algoritmo datosPersonales
	Definir nombre, nacion, ciudad Como Caracter
	Escribir 'Ingresa tu nombre y apellido'
	Leer nombre
	Escribir 'Ingresa tu pais de Nacionalidad'
	Leer nación
	Escribir 'Ingresa tu ciudad donde naciste'
	Leer ciudad
	Escribir 'Tu nombre es ', nombre
	Escribir 'Naciste en el país de ', nación
	Escribir 'Naciste en la ciudad de ', ciudad
FinAlgoritmo
