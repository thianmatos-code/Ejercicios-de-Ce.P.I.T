Algoritmo Precio
	Definir precioOriginal como entero
	Definir precio_final como entero
	Escribir 'ingresar precioOriginal'
	Leer precioOriginal
	Si precioOriginal>1000 Entonces
		precio_final = precioOriginal*0.9
		Escribir 'El precio final es: ',precio_final
	SiNo
		Escribir 'El precio  final es: ',precioOriginal
	FinSi
FinAlgoritmo
